# Root local development defaults.
# Copy this file to .env when configuring local services.

# Local Docker Compose PostgreSQL settings.
# Keep these aligned with an existing local postgres-data volume unless you intend
# to recreate or migrate the local database separately.
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_DB=campus_events
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://<postgres_user>:<postgres_password>@localhost:5432/<postgres_db>
LOCAL_DATABASE_URL=postgresql://<postgres_user>:<url_encoded_postgres_password>@postgres:5432/<postgres_db>
# Azure PostgreSQL example for later cloud deployment only.
# Keep real credentials out of Git.
# DATABASE_URL=postgresql://<admin_user>:<password>@<server-name>.postgres.database.azure.com:5432/<database_name>?sslmode=require

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

VITE_USER_SERVICE_URL=http://localhost:4001
VITE_EVENT_SERVICE_URL=http://localhost:4002
VITE_BOOKING_SERVICE_URL=http://localhost:4003

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=event-images
MAX_IMAGE_UPLOAD_BYTES=5242880

# Optional Booking Service queue integration for Azure Functions notifications.
# Leave empty in local development to skip queue publishing.
BOOKING_NOTIFICATION_STORAGE_CONNECTION_STRING=
BOOKING_NOTIFICATION_QUEUE=booking-notifications
