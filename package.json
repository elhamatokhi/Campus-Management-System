{
  "name": "campus-event-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud IT final project monorepo for a campus event management system.",
  "workspaces": [
    "frontend",
    "services/user-service",
    "services/event-service",
    "services/booking-service",
    "azure-function"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:user-service": "npm run dev -w services/user-service",
    "dev:event-service": "npm run dev -w services/event-service",
    "dev:booking-service": "npm run dev -w services/booking-service",
    "build": "npm run build -w frontend",
    "docker:build": "npm run docker:build:frontend && npm run docker:build:user-service && npm run docker:build:event-service && npm run docker:build:booking-service",
    "docker:build:frontend": "docker build -f frontend/Dockerfile -t campus-frontend .",
    "docker:build:user-service": "docker build -f services/user-service/Dockerfile -t campus-user-service .",
    "docker:build:event-service": "docker build -f services/event-service/Dockerfile -t campus-event-service .",
    "docker:build:booking-service": "docker build -f services/booking-service/Dockerfile -t campus-booking-service .",
    "lint": "npm run lint -w frontend && npm run lint -w services/user-service && npm run lint -w services/event-service && npm run lint -w services/booking-service",
    "test": "npm run test -w frontend && npm run test -w services/user-service && npm run test -w services/event-service && npm run test -w services/booking-service && npm run test -w azure-function",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:reset-demo": "node prisma/reset-demo-data.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^6.14.0"
  },
  "engines": {
    "node": ">=20"
  }
}
