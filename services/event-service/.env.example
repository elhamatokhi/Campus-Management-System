PORT=4002
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_the_same_secret_used_by_user_service
JWT_EXPIRES_IN=1d

DATABASE_URL=postgresql://<postgres_user>:<url_encoded_postgres_password>@localhost:5432/<postgres_db>

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=event-images
MAX_IMAGE_UPLOAD_BYTES=5242880
